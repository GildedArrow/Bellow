jmp start ;jump past subroutines to avoid calling before they're needed

.subtract_1 ;just subtracts 1 from register 0
sub #0, 1, 0
ret

.start
mov 10, 0 ;put value 10 into register 0
prc #0, 0 ;print value at register 0
prc 10, 1 ;print new line
jsr subtract_1 ;call subroutine
prc #0, 0 ;print value at register 0 again

;output:
;10
;9

