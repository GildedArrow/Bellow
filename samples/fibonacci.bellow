// Description: Prints the first 10 fibonacci numbers in Bellow
// Written by: Will Terry

const iters 10 // Change this value to the desired iterations
var x
var y
var z
var i

mov iters, i
mov 1, y

.fibonacci
	out #x, 0
	out 10, 1

	add #x, #y, z
	mov #y, x
	mov #z, y

	dec i
jnz fibonacci, #i
