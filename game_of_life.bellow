;Conway's Game of Life in Bellow
;Author: Will Terry
;License: Public Domain
;Description: outputs Conway's Game of Life


jmp start

;====EVOLVE GENERATION====
.evolve
ret

.swap_grid
ret
;=========================


;====COUNT CELLS====
;248 -> cell that's being pointed to
;247 -> holds the number of neighboring cells after each call

; 0 0 0
; 0 1 0
; 0 0 0
;
;

.sum_top_left
mod #248, #254, 245

jeq l1 #245, 0 ;skip counting if cell in leftmost row
jle l1 #248, #254 ;skip counting if cell in topmost row

;width - 1
mov #254, 244
dec 244

add #244, #248, 243

jpz l1, #243

inc 247

.l1
ret

.sum_top
ret

.sum_top_right
ret

.sum_left
ret

.sum_right
ret

.sum_bottom_left
ret

.sum_bottom
ret

.sum_bottom_right
ret

;..............
.count_cells
mov 0, 247

jsr sum_top_left
jsr sum_top
jsr sum_top_right
jsr sum_left
jsr sum_right
jsr sum_bottom_left
jsr sum_bottom
jsr sum_bottom_right

ret
;===================


;====OUTPUT BOARD====
.print_board
mov #253, 251; set #251 to size y of board
mov 0, 250; row offset var

.print_loop
add #250, #254, 249
dec 249

out #250, #249, 0
prc 10, 1

add #250, #254, 250

dec 251
jnz print_loop, #251

prc 10, 1
ret
;====================


;====START====
.start
mov 3, 255 ;number of iterations
mov 3, 254 ;size of board x
mov 3, 253 ;size of board y

;set board
mov 1, 3
mov 1, 4
mov 1, 5
mov 4, 248

;=============


;====MAIN LOOP====
.loop

jsr print_board
jsr count_cells


dec 255
jnz loop, #255
prc #247, 0

;=================